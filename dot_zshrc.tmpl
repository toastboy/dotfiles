# Just go ahead and update: I never say no anyway
zstyle ':omz:update' mode auto

# Allow agent forwarding: see https://github.com/ohmyzsh/ohmyzsh/tree/master/plugins/ssh-agent
zstyle :omz:plugins:ssh-agent agent-forwarding yes

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
# One list for every OS: Oh My Zsh ignores plugins whose tools aren't installed
plugins=(ansible argocd azure brew docker docker-compose git helm history-substring-search kubectl rsync ssh ssh-agent systemd terraform ubuntu)
source $ZSH/oh-my-zsh.sh

# CONDITIONAL (the only one in this file): macOS-only setup. It can't be a
# separate file because ordering matters, e.g. PATH before the tools below.
{{- if eq .chezmoi.os "darwin" }}
export PATH="/opt/homebrew/opt/openssh/bin:$PATH"

# Claude Code comes from the Homebrew cask; have it run the upgrade itself
export CLAUDE_CODE_PACKAGE_MANAGER_AUTO_UPDATE=1

# nvm, loaded on first use of nvm/node/npm/npx to keep shell startup fast
export NVM_DIR="$HOME/.nvm"
_nvm_lazy_load() {
  unset -f nvm node npm npx
  source /opt/homebrew/opt/nvm/nvm.sh
}
for _cmd in nvm node npm npx; do
  eval "$_cmd() { _nvm_lazy_load; $_cmd \"\$@\"; }"
done
unset _cmd
{{- end }}

export PATH="$HOME/.local/bin:$PATH"

# GitHub MCP server (Claude Code plugin) auth — reuses gh CLI's token
export GITHUB_PERSONAL_ACCESS_TOKEN="$(gh auth token 2>/dev/null)"

# Entire CLI shell completion (Oh My Zsh has already run compinit)
# GUARD (a deliberate exception): entire is installed on macOS only, not on Linux.
if command -v entire >/dev/null 2>&1; then
  source <(entire completion zsh)
fi

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
